<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://example.com/soap" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             name="legacy_soap_integrationSOAPService" targetNamespace="http://example.com/soap">
    <message name="Request">
        <part name="input" type="xsd:string"/>
    </message>
    <message name="Response">
        <part name="output" type="xsd:string"/>
    </message>
    <portType name="legacy_soap_integrationPortType">
        <operation name="legacy_soap_integrationOperation">
            <input message="tns:Request"/>
            <output message="tns:Response"/>
        </operation>
    </portType>
    <binding name="legacy_soap_integrationBinding" type="tns:legacy_soap_integrationPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="legacy_soap_integrationOperation">
            <soap:operation soapAction="legacy_soap_integrationAction"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>
    <service name="legacy_soap_integrationService">
        <port name="legacy_soap_integrationPort" binding="tns:legacy_soap_integrationBinding">
            <soap:address location="http://localhost:5003/legacy_soap_integration"/>
        </port>
    </service>
</definitions>
